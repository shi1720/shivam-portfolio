{
 "hosting": {
  "site":"shivam-web-app","public":"dist",
  "ignore":["firebase.json","**/.*","**/node_modules/**"],
  "headers":[
   {"source":"**","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Frame-Options","value":"DENY"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},{"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' mailto:"}]},
   {"source":"/assets/**","headers":[{"key":"Cache-Control","value":"public,max-age=31536000,immutable"}]}
  ],
  "rewrites":[{"source":"/api/**","run":{"serviceId":"shivam-portfolio-ai","region":"us-central1","pinTag":true}},{"source":"**","destination":"/index.html"}]
 },
 "firestore":[{"database":"shivam-portfolio","rules":"firestore.rules"}]
}
